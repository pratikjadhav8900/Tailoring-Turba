# ==============================================================================
# TAILORING TURBA — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local and fill in your actual credentials.
# NEVER commit .env or .env.local containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon PostgreSQL / Local Postgres)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / AUTHENTICATION
# ------------------------------------------------------------------------------
# Generated via `openssl rand -base64 32`
AUTH_SECRET="your-32-character-or-longer-random-auth-secret-here"
NEXTAUTH_SECRET="your-32-character-or-longer-random-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated list of emails authorized for SUPER_ADMIN role bootstrap
SUPER_ADMIN_EMAILS="admin@example.com"

# ------------------------------------------------------------------------------
# 3. OAUTH PROVIDERS
# ------------------------------------------------------------------------------
# Google OAuth Console
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Apple Sign In (Optional)
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_api_key_secret"
# Dedicated secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 5. LOGISTICS & SHIPPING (BigShip Direct)
# ------------------------------------------------------------------------------
BIGSHIP_BASE_URL="https://api.bigship.direct/"
BIGSHIP_USERNAME="your_bigship_username"
BIGSHIP_PASSWORD="your_bigship_password"
BIGSHIP_ACCESS_KEY="your_bigship_access_key"
# Dedicated secret verified on incoming BigShip tracking webhooks
BIGSHIP_WEBHOOK_SECRET="your_dedicated_bigship_webhook_secret_min_32_chars"

# ------------------------------------------------------------------------------
# 6. MEDIA ASSET STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ------------------------------------------------------------------------------
# 7. EMAIL DELIVERY (Nodemailer / SMTP & Resend)
# ------------------------------------------------------------------------------
EMAIL_FROM="Tailoring Turba <no-reply@yourdomain.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"

# Optional fallback provider
RESEND_API_KEY=""

# ------------------------------------------------------------------------------
# 8. CRM INTEGRATION (HubSpot)
# ------------------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# 9. FIREBASE AUTHENTICATION (Phone OTP Verification)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:000000000000"

# Firebase Admin SDK Service Account (Server-side token verification)
FIREBASE_PROJECT_ID="your-app-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-app-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...your-private-key...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 10. BOT & DDOS PROTECTION (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ------------------------------------------------------------------------------
# 11. COMMUNICATION & PUBLIC CONTACT
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="919022553346"

# ------------------------------------------------------------------------------
# 12. TEST & DEVELOPMENT FLAGS
# ------------------------------------------------------------------------------
# Mock auth is ONLY allowed when NODE_ENV="test"
ENABLE_MOCK_AUTH="false"

# ------------------------------------------------------------------------------
# 13. TURBA AI APPAREL CONSULTANT (Google Gemini API)
# ------------------------------------------------------------------------------
# Server-side only key for Turba AI assistant. Never expose to client!
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 14. DEV TOOLING
# ------------------------------------------------------------------------------
# Login password for scripts/capture-manual-screenshots.js and scripts/recapture-clean.js
# (the Ops account those scripts log in as to screenshot the manual pages). Dev-only.
OPS_SCREENSHOT_PASSWORD=""
# Server-side Razorpay key id — several API routes read this directly (not just the
# NEXT_PUBLIC_ variant above, which is for the client-side checkout widget only).
RAZORPAY_KEY_ID=""
# Meta Lead Ads webhook payload signature verification (X-Hub-Signature-256). Required
# for /api/crm/webhooks/meta to accept any lead — without it the route fails closed.
META_APP_SECRET=""
# GET handshake verify token + Graph API token for fetching the real lead data —
# both used by /api/crm/webhooks/meta but previously missing from this file.
META_WEBHOOK_VERIFY_TOKEN=""
META_PAGE_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# 15. TURBA CRM — WHATSAPP BROADCASTING (Meta WhatsApp Cloud API, direct — no BSP)
# ------------------------------------------------------------------------------
# All required for /crm/whatsapp to work at all. Set up in Meta Business Manager:
# a verified WhatsApp Business Account, a phone number, and at least one
# APPROVED message template (business-initiated messages MUST use a template —
# free-text bulk sends are not possible). None of this can be configured from
# code; see PROJECT_CONTEXT.md.
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
# GET handshake verify token for /api/crm/webhooks/whatsapp (delivery-status updates).
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# HMAC signature secret for the same webhook's POSTs (X-Hub-Signature-256).
# Only reuse META_APP_SECRET above if the WhatsApp integration lives in the same Meta App.
META_WHATSAPP_APP_SECRET=""
# Optional — Graph API version to call, e.g. "v22.0". Defaults to v21.0 if unset.
META_GRAPH_API_VERSION=""

# ------------------------------------------------------------------------------
# 16. CRON JOBS (Vercel Cron — see vercel.json)
# ------------------------------------------------------------------------------
# Vercel auto-sends this as "Authorization: Bearer <value>" on scheduled cron
# invocations. Required for /api/cron/whatsapp-sender — without it the route
# rejects every request, including Vercel's own cron trigger.
CRON_SECRET=""
