generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  phone         String?
  phoneVerified DateTime?
  firebaseUid   String?   @unique
  companyName   String?
  gstNumber     String?
  isB2BApproved Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  Address       Address[]
  bookings      Booking[]
  designs       Design[]
  orders        Order[]
  assets        UserAsset[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  image    String?
  products Product[]
}

model Product {
  id               String      @id @default(cuid())
  name             String
  description      String
  shortDescription String?
  basePrice        Float
  minOrderQuantity Int         @default(10)
  categoryId       String
  images           String[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  badge            String?
  colors           Int?
  colorsJson       Json?
  features         String[]
  type             String?
  brand            String?
  isActive         Boolean     @default(true)

  // Classification fields
  sku              String?
  department       String?
  productType      String?
  style            String?
  gender           String?
  qualityTier      String?
  collection       String?

  // Fabric & Specifications
  fabric           String?
  fabricComposition String?
  gsm              Int?
  fit              String?
  neckType         String?
  sleeveType       String?
  pattern          String?
  careInstructions String?
  countryOfOrigin  String?     @default("India")

  // Sizes & Media Metadata
  sizes            String[]    @default([])
  mediaMetadata    Json?

  designs          Design[]
  orderItems       OrderItem[]
  category         Category    @relation(fields: [categoryId], references: [id])
  
  // SEO optimization fields
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  slug             String?     @unique
}

model Design {
  id              String      @id @default(cuid())
  userId          String
  productId       String?
  name            String
  imageUrl        String?
  rawUrl          String?
  stateJson       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sourceProductId String?
  product         Product?    @relation(fields: [productId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  orderItems      OrderItem[]
}

model Order {
  id                    String      @id @default(cuid())
  userId                String
  totalAmount           Float
  status                OrderStatus @default(PENDING)
  paymentId             String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  shippingAddressId     String?
  orderNumber           Int         @unique @default(autoincrement())
  razorpayOrderId       String?     @unique
  bigshipCourierName    String?
  bigshipLabelUrl       String?
  bigshipManifestUrl    String?
  bigshipOrderId        String?
  bigshipTrackingId     String?
  shippingCharge        Float?
  amountPaid            Float       @default(0)
  isSplitPayment        Boolean     @default(false)
  refundId              String?
  refundedAmount        Float?
  remainingAmount       Float       @default(0)
  secondPaymentId       String?
  secondPaymentStatus   String?
  secondRazorpayOrderId String?     @unique
  shippingAddress       Address?    @relation(fields: [shippingAddressId], references: [id])
  user                  User        @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  orderSheet            OrderSheet?
  feedback              OrderFeedback?
  paymentTransactions   PaymentTransaction[]
  shipments             Shipment[]
  timelineEvents        OrderTimelineEvent[]
  outboxNotifications   OutboxNotification[]
  productionStage       ProductionStage? @default(QUEUED)
  qcPassedAt            DateTime?
  qcNotes               String?
  dispatchOverrideReason String?
  dispatchOverriddenBy  String?
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  price           Float
  designId        String?
  customStateJson String?
  printFiles      String[]
  mockupUrl       String?
  mockupUrlBack   String?
  mockupUrlLeft   String?
  mockupUrlRight  String?
  design          Design?  @relation(fields: [designId], references: [id])
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])
}

model OrderSheet {
  id        String   @id @default(cuid())
  orderId   String   @unique
  sheetData Json
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderFeedback {
  id                    String   @id @default(cuid())
  orderId               String   @unique
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceOverall        Int      // Q1: Overall experience (1-5)
  serviceProfessionalism Int      // Q2: Professionalism/helpfulness (1-5)
  serviceTimeline       Int      // Q3: Delivery timeline (1-5)
  easeOrdering          Int      // Q4: Ease of placing order (1-5)
  easeCommunication     Int      // Q5: Communication and updates (1-5)
  easeProcess           Int      // Q6: Ordering and approval process (1-5)
  fabricQuality         Int      // Q7: Fabric quality (1-5)
  fabricExpectations    Int      // Q8: Comfort, durability, finish (1-5)
  fabricStitching       Int      // Q9: Stitching and garment quality (1-5)
  printingLogo          Int      // Q10: Logo/print/embroidery quality (1-5)
  printingAccuracy      Int      // Q11: Color, design, placement accuracy (1-5)
  comment               String?  @db.Text // Q12: Improvements suggestion
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Booking {
  id         String        @id @default(cuid())
  userId     String?
  date       DateTime
  timeSlot   String
  status     BookingStatus @default(REQUESTED)
  notes      String?
  createdAt  DateTime      @default(now())
  guestEmail String?
  guestName  String?
  guestPhone String?
  user       User?         @relation(fields: [userId], references: [id])
}

model CatalogueCategory {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String
  hsn         String?
  gst         String?
  pages       Int[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  products    CatalogueProduct[]
}

model CatalogueProduct {
  id               String            @id @default(cuid())
  code             String
  name             String
  spec             String?
  hsn              String?
  gst              String?
  minOrderQuantity Int               @default(50)
  isB2B            Boolean           @default(true)
  categoryId       String
  createdAt        DateTime          @default(now())
  category         CatalogueCategory @relation(fields: [categoryId], references: [id])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  name       String
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
}

model Inquiry {
  id           String        @id @default(cuid())
  name         String
  email        String
  companyName  String?
  quantity     Int
  requirements String
  status       InquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  phone        String?
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  otp     String   @unique
  expires DateTime

  @@unique([email, otp])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expires])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  IN_PRODUCTION
  QUALITY_CHECK
  READY_TO_SHIP
  DISPATCHED
  SHIPPED
  DELIVERED
  CANCELLED
  CATALOGUE_ENQUIRY
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  SAMPLE_SENT
  CONVERTED
  CLOSED
}

model UserAsset {
  id        String   @id @default(cuid())
  userId    String
  url       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id               String   @id @default(cuid())
  title            String
  department       String
  location         String
  type             String
  salaryRange      String
  description      String
  requirements     String[]
  responsibilities String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UsedSignupAttempt {
  id        String   @id @default(cuid())
  attemptId String   @unique
  createdAt DateTime @default(now())
}

model OtpRequestLog {
  id        String   @id @default(cuid())
  phone     String
  ip        String
  createdAt DateTime @default(now())
}

enum ProductionStage {
  QUEUED
  FABRIC_ALLOCATION
  PRINTING_EMBROIDERY
  STITCHING
  QC_INSPECTION
  PACKED
}

enum TransactionType {
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  MANUAL_BANK_TRANSFER
  UPI_MANUAL
  CASH
  SYSTEM_ADJUSTMENT
}

model PaymentTransaction {
  id                String            @id @default(cuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountPaise       Int
  currency          String            @default("INR")
  type              TransactionType   @default(PAYMENT)
  status            TransactionStatus @default(PENDING)
  provider          PaymentProvider   @default(RAZORPAY)
  providerOrderId   String?
  providerPaymentId String?           @unique
  providerSignature String?
  failureReason     String?
  referenceNote     String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
}

enum ShipmentStatus {
  NOT_CREATED
  BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED_TO_ORIGIN
  CANCELLED
}

enum CourierProvider {
  BIGSHIP
  LOCAL_COURIER
  DIRECT_PICKUP
  OTHER
}

model Shipment {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentNumber      Int             @default(1)
  status              ShipmentStatus  @default(NOT_CREATED)
  provider            CourierProvider @default(BIGSHIP)
  courierName         String?
  awbNumber           String?
  providerOrderId     String?
  labelUrl            String?
  manifestUrl         String?
  shippingChargePaise Int?
  weightKg            Float?
  dimensionsCm        Json?
  pickupWarehouseId   String?
  checkpoints         Json?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([orderId])
  @@index([awbNumber])
  @@index([status])
}

model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  orderId     String?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventId])
}

enum EventActorRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  SYSTEM_WORKER
  WEBHOOK
}

model OrderTimelineEvent {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType         String
  title             String
  description       String?
  actorId           String?
  actorName         String
  actorRole         EventActorRole @default(SYSTEM_WORKER)
  isCustomerVisible Boolean        @default(true)
  metadata          Json?
  createdAt         DateTime       @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@index([isCustomerVisible])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model OutboxNotification {
  id           String             @id @default(cuid())
  orderId      String
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel      String             @default("EMAIL")
  template     String
  recipient    String
  payload      Json
  status       NotificationStatus @default(PENDING)
  attemptCount Int                @default(0)
  maxAttempts  Int                @default(5)
  lastError    String?
  processedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, attemptCount])
  @@index([orderId])
}

