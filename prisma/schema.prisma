generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  phone         String?
  companyName   String?
  gstNumber     String?
  isB2BApproved Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  Address       Address[]
  bookings      Booking[]
  designs       Design[]
  orders        Order[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  image    String?
  products Product[]
}

model Product {
  id               String      @id @default(cuid())
  name             String
  description      String
  basePrice        Float
  minOrderQuantity Int         @default(10)
  categoryId       String
  images           String[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  badge            String?
  colors           Int?
  features         String[]
  type             String?
  designs          Design[]
  orderItems       OrderItem[]
  category         Category    @relation(fields: [categoryId], references: [id])
}

model Design {
  id              String      @id @default(cuid())
  userId          String
  productId       String?
  name            String
  imageUrl        String?
  rawUrl          String?
  stateJson       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sourceProductId String?
  product         Product?    @relation(fields: [productId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  orderItems      OrderItem[]
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  totalAmount       Float
  status            OrderStatus @default(PENDING)
  paymentId         String?
  razorpayOrderId   String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  shippingAddressId String?
  orderNumber       Int         @unique @default(autoincrement())
  shippingAddress   Address?    @relation(fields: [shippingAddressId], references: [id])
  user              User        @relation(fields: [userId], references: [id])
  items             OrderItem[]
  orderSheet        OrderSheet?
  
  // BigShip Logistics
  shippingCharge    Float?
  bigshipOrderId    String?
  bigshipTrackingId String?
  bigshipLabelUrl   String?
  bigshipManifestUrl String?
  bigshipCourierName String?
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  price           Float
  designId        String?
  customStateJson String?
  printFiles      String[]
  mockupUrl       String?
  mockupUrlBack   String?
  design          Design?  @relation(fields: [designId], references: [id])
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])
}

model OrderSheet {
  id        String   @id @default(cuid())
  orderId   String   @unique
  sheetData Json
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Booking {
  id         String        @id @default(cuid())
  userId     String?
  date       DateTime
  timeSlot   String
  status     BookingStatus @default(REQUESTED)
  notes      String?
  createdAt  DateTime      @default(now())
  guestEmail String?
  guestName  String?
  guestPhone String?
  user       User?         @relation(fields: [userId], references: [id])
}

model CatalogueCategory {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String
  hsn         String?
  gst         String?
  pages       Int[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  products    CatalogueProduct[]
}

model CatalogueProduct {
  id               String            @id @default(cuid())
  code             String
  name             String
  spec             String?
  hsn              String?
  gst              String?
  minOrderQuantity Int               @default(50)
  isB2B            Boolean           @default(true)
  categoryId       String
  createdAt        DateTime          @default(now())
  category         CatalogueCategory @relation(fields: [categoryId], references: [id])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  name       String
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
}

model Inquiry {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String?
  companyName  String?
  quantity     Int
  requirements String
  status       InquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  otp     String   @unique
  expires DateTime

  @@unique([email, otp])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  CATALOGUE_ENQUIRY
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  SAMPLE_SENT
  CONVERTED
  CLOSED
}
